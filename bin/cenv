#!/bin/bash -e

find_this_cenv_command() {
    (echo "${0}" | grep -q '^/') && echo "${0}" || (cd "`pwd`/`dirname \"${0}\"`" && echo "`pwd`/`basename ${0}`")
}
export CENV_BIN=`find_this_cenv_command`

test -f "${HOME}/.cenvrc" && source "${HOME}/.cenvrc"

legacy_default_basedir="${HOME}/.venv"
default_basedir="${HOME}/.cenv"

if [ -e "${legacy_default_basedir}" -a ! -e "${default_basedir}" ]; then
    default_basedir="${legacy_default_basedir}"
fi

export CENV_BASE_DIR="${CENV_BASE_DIR:-${VENV_BASE_DIR:-${default_basedir}}}"

if [ "${CENV_BASE_DIR}" = "${legacy_default_basedir}" ]; then
    echo "WARNING: Defaulting to legacy CENV_BASE_DIR=\"\${HOME}/.venv\", please rename \"\${HOME}/.venv\" to \"\${HOME}/.cenv\". Support for \"\${HOME}/.venv\" will be removed in the future!" >&2
fi

# Architecture ("uname -m" naming) of the container images to use. Container
# environment directories may be shared between machines of different
# architectures, holding an image for each of them:
export CENV_ARCH="${CENV_ARCH:-`uname -m`}"


# Prints the path of the rootfs with the given name suffix ("-ARCH" or "") in
# a container environment directory, returns non-zero if there is none:
find_cenv_rootfs_variant() {
    local cenv_dir="$1"
    local suffix="$2"
    local ext

    if [ -d "${cenv_dir}/rootfs${suffix}" ]; then
        echo "${cenv_dir}/rootfs${suffix}/"
        return 0
    fi

    for ext in sif sqsh img ; do
        if [ -f "${cenv_dir}/rootfs${suffix}.${ext}" ]; then
            echo "${cenv_dir}/rootfs${suffix}.${ext}"
            return 0
        fi
    done

    return 1
}


# Finds the rootfs of a container environment directory. Architecture-specific
# entries ("rootfs-${CENV_ARCH}[.EXT]") take precedence over the
# architecture-independent ones ("rootfs[.EXT]"). Prints the rootfs path,
# returns non-zero if no rootfs was found:
find_cenv_rootfs() {
    find_cenv_rootfs_variant "$1" "-${CENV_ARCH}" || find_cenv_rootfs_variant "$1" ""
}


set_cenv_runtime() {
    apptainer_cmd=`command -v apptainer || true`
    singularity_cmd=`command -v singularity || true`
    shifter_cmd=`command -v shifter || true`

    export CENV_RUNTIME="${CENV_RUNTIME:-auto}"
    if [ "${CENV_RUNTIME}" = "auto" ] ; then
        if [ -n "${apptainer_cmd}" ] ; then
            export CENV_RUNTIME="apptainer"
        elif [ -n "${singularity_cmd}" ] ; then
            export CENV_RUNTIME="singularity"
        elif  [ -n "${shifter_cmd}" ] ; then
            export CENV_RUNTIME="shifter"
        else
            echo "ERROR: No cenv-compatible container runtime engine (apptainer, singularity or shifter) found." >&2
            exit 1
        fi
    fi

    # echo "DEBUG: Selected container runtime engine ${CENV_RUNTIME}" >&2

    if [ "${CENV_RUNTIME}" = "apptainer" ] ; then
        if [ -z "${apptainer_cmd}" ] ; then
            echo "ERROR: Can't find apptainer executable." >&2
            exit 1
        fi
    elif [ "${CENV_RUNTIME}" = "singularity" ] ; then
        if [ -z "${singularity_cmd}" ] ; then
            echo "ERROR: Can't find singularity executable." >&2
            exit 1
        fi
    elif [ "${CENV_RUNTIME}" = "shifter" ] ; then
        if [ -z "${shifter_cmd}" ] ; then
            echo "ERROR: Can't find shifter executable." >&2
            exit 1
        fi
    else
        echo "ERROR: Unsupported cenv container runtime engine \"${CENV_RUNTIME}\"." >&2
        exit 1
    fi
}

absname() {
    local REL_PATH="$1"
    local REL_DIRNAME="$(dirname "${REL_PATH}")"
    local ABS_DIRNAME="$(\cd "${REL_DIRNAME}" && pwd)"
    if [ -z "$ABS_DIRNAME" ] ; then
        echo "ERROR: Couldn't determine absolute path of \"${REL_DIRNAME}\"" >&2
        return 1
    fi
    local BASENAME="$(basename "$1")"
    if [ "${ABS_DIRNAME}" == "/" ] ; then
        if [ "${BASENAME}" == "/" ] ; then
            echo "/"
        else
            echo "/${BASENAME}"
        fi
    else
        echo "${ABS_DIRNAME}/${BASENAME}"
    fi
}


cenv_help() {
local PROG_NAME=`basename $0`
cat <<EOF
${PROG_NAME} - virtual enviroment management

    ${PROG_NAME} [shell|program [...]]
    ${PROG_NAME} --list
    ${PROG_NAME} --create CENV_NAME APPTAINER_IMAGE.sif
    ${PROG_NAME} --create CENV_NAME SINGULARITY_IMAGE.sif
    ${PROG_NAME} --create CENV_NAME DOCKER_IMAGE
    ${PROG_NAME} --instance CENV_NAME/SESSION_NAME [shell|program [...]]
    ${PROG_NAME} --instances [CENV_NAME]
    ${PROG_NAME} --stop CENV_NAME/SESSION_NAME

Use and manage virtual environments based on Apptainer (https://apptainer.org),
Singularity (https://sylabs.io) or Shifter
(https://docs.nersc.gov/development/shifter) containers/images.


USAGE
-----

    ${PROG_NAME} CENV_NAME
    ${PROG_NAME} CENV_NAME shell
    ${PROG_NAME} CENV_NAME PROGRAM [ARG...]

Runs either the default action defined for the container image (often, a
shell), otherwise a shell or a program with the given arguments.

    ${PROG_NAME} --list [-v]

List all defined virtual environments. With option \`-v\`, lists for the
names and paths of the virtual environments.

    ${PROG_NAME} --create CENV_NAME APPTAINER_IMAGE[.sif]
    ${PROG_NAME} --create CENV_NAME SINGULARITY_IMAGE[.sif]

Create a virtual enviroment named \`CENV_NAME\` inside
"\$CENV_BASE_DIR/CENV_NAME" and associate it with the Apptainer or
Singularity container image "IMAGE[.sif]".

    ${PROG_NAME} --create CENV_NAME DOCKER_IMAGE

Create a virtual enviroment named \`CENV_NAME\` inside
"\$CENV_BASE_DIR/CENV_NAME" and associate it with \`DOCKER_IMAGE\` for use
with Shifter.


CONTAINER INSTANCES
-------------------

Long-running container instances allow for running several shells and
programs in the same container at the same time. They share the mount, PID
and IPC namespaces of the instance, so they can see and talk to each other
(e.g. an interactive shell, a VS Code tunnel server and an AI coding agent).
This is especially useful on remote and batch nodes.

Container instances require Apptainer or Singularity, they are not available
with Shifter.

    ${PROG_NAME} --instance CENV_NAME/SESSION_NAME
    ${PROG_NAME} --instance CENV_NAME/SESSION_NAME shell
    ${PROG_NAME} --instance CENV_NAME/SESSION_NAME PROGRAM [ARG...]

Run a shell or a program in the container instance \`SESSION_NAME\` of the
virtual environment \`CENV_NAME\`. The instance is started if it is not
running yet, so this can be used both to create instances and to connect to
them. \`SESSION_NAME\` may contain letters, digits, "_" and "-".

Note that container image, bind mounts and other container options are fixed
when an instance starts. Changes to the configuration of an environment only
take effect for instances started afterwards.

    ${PROG_NAME} --instances [CENV_NAME]

List the running container instances as "CENV_NAME/SESSION_NAME", either of
all virtual environments or only of the environment \`CENV_NAME\`.

    ${PROG_NAME} --stop CENV_NAME/SESSION_NAME

Stop the container instance \`SESSION_NAME\` of the virtual environment
\`CENV_NAME\`. This terminates all processes running in the instance.


ENVIRONMENT VARIABLES
---------------------

* CENV_BASE_DIR     Base path for virtual environment directories. Defaults
                    to "\${HOME}/.cenv".

* CENV_USER_DIR     Host directory used as the "user"-directory for storing
                    user-specific data. Defaults to
                    "\${CENV_BASE_DIR}/\${CENV_NAME}/user"
                     (located inside virtual environment directory).

* CENV_USER_MNT     Site-independent mount point for "\${CENV_USER_DIR}" in
                    container instance for "user"-directory. Defaults to "/user".

* CENV_HOME_DIR     Host directory to use/mount as the home directory inside the
                    container. Defaults to "\${HOME}".

* CENV_HOME_MNT     Site-independent mount point in container instance for
                    "\${HOME}". Defaults to "/homedir". "${HOME}" itself will
                    still (depending on the runtime configuration) be available
                    under it's original path as well.

* CENV_VSCS_MNT     Site-independent mount point in container instance for
                    "\${CENV_USER_MNT}/.vscode-server". Defaults to
                    "\${HOME}/.vscode-server".

* CENV_RUNTIME      cenv container runtime engine, either "apptainer",
                    "singularity", "shifter" or "auto" (the default).

* CENV_GPU          (Apptainer/Singularity only) Select GPU backend, currently
                    may be "cuda", "rocm", "opencl", a comma-separated list of
                    those, or "none". If not set or empty, cenv will try to
                    autodetect the available backend(s).

* CENV_APPTAINER_OPTS  Additional options to pass when running "apptainer", e.g.
                       "-B /some/dir:/some/dir".

* CENV_SINGULARITY_OPTS  Additional options to pass when running "singularity",
                         e.g. "-B /some/dir:/some/dir".

* CENV_SHIFTER_OPTS  Additional to pass when running "shifter".

cenv sets the environment variable CENV_BIN to the absolute path to cenv
itself. This can be useful in distributed scenarios, e.g. when generating
batch job scripts that should not rely on cenv being on PATH.


CONTAINER IMAGES
----------------

${PROG_NAME} looks for the container image of an environment in
"\$CENV_BASE_DIR/\$CENV_NAME", as a directory "rootfs" or a file
"rootfs.sif", "rootfs.sqsh" or "rootfs.img" (may be symlinks). These are
typically created by \`${PROG_NAME} --create\`.

Architecture-specific variants "rootfs-\$CENV_ARCH[.EXT]" (e.g.
"rootfs-x86_64.sif", "rootfs-aarch64.sif") take precedence over the
architecture-independent ones, so a single environment directory can be
shared between machines of different architectures. \`${PROG_NAME} --create\`
creates architecture-specific entries; run it once per architecture to add
an image for each of them.


CONFIGURATION FILES
-------------------

* "\$HOME/.cenvrc"  If present, ${PROG_NAME} will "source" this (bash
  compatible) shell script before doing anything else. It's a convenient
  place to set environment variables like CENV_BASE_DIR,
  CENV_APPTAINER_OPTS, etc.

* "\$CENV_BASE_DIR/\$CENV_NAME/cenvrc" Create this file after
  creating the container environment to set up environment-specific options. If
  present, ${PROG_NAME} will "source" this (bash compatible) shell script
  before invoking the container runtime.
EOF
} # swmod_list_usage()


invalid_argument_error() {
    if [ -n "${1}" ] ; then
        echo "ERROR: Invalid arguments in \``basename $0` $@\`." >&2
    else
        echo "ERROR: First argument of \``basename $0`\` must not be empty." >&2
    fi
    echo "Run \``basename $0` --help\` for instructions." >&2
    exit 1
} # swmod_list_usage()


cenv_list() {
    for dir in `echo ${CENV_BASE_DIR}/*/rootfs* | xargs -n 1 dirname | grep -v '\*' | sort -u`; do
        if [ "$1" == "-v" ] ; then
            echo "`basename ${dir}`: ${dir}"
        else
            echo "`basename ${dir}`"
        fi
    done
}


cenv_create() {
    local CENV_NAME="$1"
    local CENV_IMG="$2"
    if [ -z "${CENV_NAME}" -o -z "${CENV_IMG}" ] ; then
        invalid_argument_error "$CENV_NAME_ARG" "$@"
    fi

    if (echo "${CENV_NAME}" | grep -q '\s') ; then
        echo "ERROR: Name of virtual environment must not contain whitespace." >&2
        exit 1
    fi

    local CENV_DIR="${CENV_BASE_DIR}/${CENV_NAME}"
    local ADD_ARCH="no"
    if [ -e "${CENV_DIR}" ] ; then
        # Adding an image for a further architecture to an existing container
        # environment is allowed, anything else is not:
        if [ -n "$(find_cenv_rootfs_variant "${CENV_DIR}" "-${CENV_ARCH}")" ] ; then
            echo "ERROR: Virtual enviromenment \"${CENV_NAME}\" (\"${CENV_DIR}\") already has a rootfs for architecture \"${CENV_ARCH}\"." >&2
            exit 1
        elif [ -z "$(ls -d "${CENV_DIR}"/rootfs* 2>/dev/null)" ] ; then
            echo "ERROR: Virtual enviromenment \"${CENV_NAME}\" (\"${CENV_DIR}\") already exists." >&2
            exit 1
        fi
        ADD_ARCH="yes"
    fi

    set_cenv_runtime
    if [ "${CENV_RUNTIME}" = "apptainer" ] ||
       [ "${CENV_RUNTIME}" = "singularity" ] ; then
        local CENV_IMG_EXT=""
        if [ -d "${CENV_IMG}" ]; then
            if [ ! -e "${CENV_IMG}/bin/sh" ] ; then
                echo "ERROR: Directory \"CENV_IMG\" doesn't seem to be a Apptainer or Singularity image (doesn't contain \"bin/sh\")." >&2
                exit 1
            fi
        elif [ -f "${CENV_IMG}" ]; then
            local CENV_IMG_BASENAME=`basename "${CENV_IMG}"`
            local CENV_IMG_EXT="${CENV_IMG_BASENAME##*.}"
            case "${CENV_IMG_EXT}" in
                "sif") ;;
                "sqsh") ;;
                "img") ;;
                *)
                    echo "ERROR: Only Apptainer/Singularity images of type directory, \"\*.sif\", \"\*.sqsh\" and \"\*.img\" are supported." >&2
                    exit 1
                    ;;
            esac
        else
            echo "ERROR: Apptainer/Singularity image \"${CENV_IMG}\" doesn't exist or is not a file or directory." >&2
            exit 1
        fi

        CENV_IMG_ABS=`absname "${CENV_IMG}"`

        if [ -z "${CENV_IMG_EXT}" ]; then
            local IMG_LINK_NAME="rootfs-${CENV_ARCH}"
        else
            local IMG_LINK_NAME="rootfs-${CENV_ARCH}.${CENV_IMG_EXT}"
        fi

        local IMG_LINK_PATH="${CENV_DIR}/${IMG_LINK_NAME}"
        if [ "${ADD_ARCH}" = "yes" ] ; then
            echo "INFO: Adding rootfs for architecture \"${CENV_ARCH}\" to virtual environment \"${CENV_NAME}\" in \"${CENV_DIR}\"" >&2
        else
            echo "INFO: Creating virtual environment \"${CENV_NAME}\" in \"${CENV_DIR}\"" >&2
        fi
        mkdir -p "${CENV_DIR}"
        ln -s "${CENV_IMG_ABS}" "${IMG_LINK_PATH}"
        if (command -v symlinks >/dev/null) ; then
            echo "INFO: Command \"symlinks\" available, using relative symlink for \"${IMG_LINK_PATH}\"." >&2
            command -v symlinks >/dev/null && symlinks -c -o "${CENV_DIR}" >/dev/null || true
        else
            echo "INFO: Command \"symlinks\" not available, using absolute symlink for \"${IMG_LINK_PATH}\"." >&2
        fi
    elif [ "${CENV_RUNTIME}" = "shifter" ] ; then
        mkdir -p "${CENV_DIR}"
        IMG_LINKFILE="${CENV_DIR}/rootfs.shifter"
        echo "${CENV_IMG}" > "${IMG_LINKFILE}"
    else
        echo "ERROR: cenv internal error." >&2; exit 1
    fi

    if [ "${ADD_ARCH}" = "yes" ] ; then
        echo "Added rootfs for architecture \"${CENV_ARCH}\" to virtual environment \"${CENV_NAME}\"." >&2
    else
        echo "Created virtual environment \"${CENV_NAME}\", run \`cenv ${CENV_NAME}\` to try it out." >&2
    fi
}


# Redirects the per-user directories of various languages and tools into the
# "user"-directory of the container environment, so that they are persistent
# but separate for each environment:
cenv_setup_tool_env_vars() {
    # Special exports for Python:
    export PYTHONUSERBASE="${CENV_USER_MNT}/.local"
    export PIP_CACHE_DIR="${CENV_USER_MNT}/.cache/pip"

    # Special exports for Pixi/rattler:
    export PIXI_CACHE_DIR="${CENV_USER_MNT}/.cache/rattler"
    export RATTLER_CACHE_DIR="${CENV_USER_MNT}/.cache/rattler"

    # Special exports for machine-learning model caches:
    export HF_HOME="${CENV_USER_MNT}/.cache/huggingface"
    export TORCH_HOME="${CENV_USER_MNT}/.cache/torch"

    # Special exports for Python JIT/compilation caches:
    export NUMBA_CACHE_DIR="${CENV_USER_MNT}/.cache/numba"
    export CUPY_CACHE_DIR="${CENV_USER_MNT}/.cache/cupy"
    export TRITON_CACHE_DIR="${CENV_USER_MNT}/.cache/triton"

    # Special exports for matplotlib:
    export MPLCONFIGDIR="${CENV_USER_MNT}/.config/matplotlib"

    # Special exports for Jupyter:
    export JUPYTER_CONFIG_DIR="${CENV_USER_MNT}/.jupyter"
    export JUPYTER_DATA_DIR="${CENV_USER_MNT}/.local/share/jupyter"

    # Special exports for IPython:
    export IPYTHONDIR="${CENV_USER_MNT}/.ipython"

    # Special exports for GitHub Atom:
    export ATOM_HOME="${CENV_USER_MNT}/.atom"

    # Special exports for Julia:
    export JULIA_PKGDIR="${CENV_USER_MNT}/.julia"
    export JULIA_DEPOT_PATH="${CENV_USER_MNT}/.julia:"
    export JULIA_PKG_DEVDIR="${CENV_USER_MNT}/.julia/dev"

    # Special exports for Rust:
    export CARGO_HOME="${CENV_USER_MNT}/.cargo"
    export RUSTUP_HOME="${CENV_USER_MNT}/.rustup"

    # Special exports for Node.js:
    export NPM_CONFIG_CACHE="${CENV_USER_MNT}/.cache/npm"
    export npm_config_devdir="${CENV_USER_MNT}/.cache/node-gyp"
    export NODE_REPL_HISTORY="${CENV_USER_MNT}/.node_repl_history"
}


# Prepares the use of the container environment "$1": Sets CENV_DIR, sources
# the environment's "cenvrc", sets the cenv environment variables and selects
# the container runtime engine:
cenv_setup() {
    local cenv_name="$1"

    CENV_DIR="${CENV_BASE_DIR}/${cenv_name}"

    if [ -f "${CENV_DIR}/cenvrc" ] ; then
        if [ -f "${CENV_DIR}/.cenvrc" ] ; then
            echo "WARNING: Both \"${CENV_DIR}/cenvrc\" and \"${CENV_DIR}/.cenvrc\" exist, using \"${CENV_DIR}/cenvrc\"." >&2
        fi
        source "${CENV_DIR}/cenvrc"
    elif [ -f "${CENV_DIR}/.cenvrc" ] ; then
        # For backward compatibility:
        echo "WARNING: Use of \"${CENV_DIR}/.cenvrc\" is deprecated, please rename it to \"${CENV_DIR}/cenvrc\"." >&2
        source "${CENV_DIR}/.cenvrc"
    fi

    export CENV_USER_MNT="${CENV_USER_MNT:-${VENV_USER_MNT:-/user}}"
    export CENV_HOME_DIR="${CENV_HOME_DIR:-${VENV_HOME_DIR:-${HOME}}}"
    export CENV_HOME_MNT="${CENV_HOME_MNT:-${VENV_HOME_MNT:-/homedir}}"
    export CENV_VSCS_MNT="${CENV_VSCS_MNT:-${VENV_HOME_MNT:-${HOME}/.vscode-server}}"

    if [ "${CENV_HOME_DIR}" != "${HOME}" ]; then
        mkdir -p "${CENV_HOME_DIR}"
    fi

    export CENV_NAME="${cenv_name}"
    # Legacy support:
    export VENV_NAME="${cenv_name}"

    cenv_setup_tool_env_vars

    set_cenv_runtime
}


# Prepares running the container environment set up by cenv_setup with
# Apptainer or Singularity: Sets FS_IMG, CENV_USER_DIR, EXTRA_OPTS and the
# bind-mount options CENV_BIND_OPTS, and exports the environment variables to
# be passed into the container:
cenv_setup_apptainer() {
    if [ ! -d "${CENV_DIR}" ]; then
        echo "ERROR: cenv directory \"${CENV_DIR}\" doesn't exist." >&2
        exit 1
    fi

    FS_IMG=`find_cenv_rootfs "${CENV_DIR}"` || {
        echo "ERROR: No rootfs found in \"${CENV_DIR}\", neither for architecture \"${CENV_ARCH}\" nor architecture-independent." >&2
        exit 1
    }

    CENV_USER_DIR="${CENV_USER_DIR:-${CENV_DIR}/user}"
    mkdir -p "${CENV_USER_DIR}"
    mkdir -p "${CENV_USER_DIR}/.vscode-server"

    if [ "${CENV_USER_MNT}" == "none" ] ; then
        CENV_USER_MNT="${CENV_USER_DIR}"
        # The tool paths were derived from the placeholder "none", redo them
        # with the actual location of the "user"-directory:
        cenv_setup_tool_env_vars
    fi

    if [ "${CENV_RUNTIME}" = "apptainer" ]; then
        EXTRA_OPTS="${CENV_APPTAINER_OPTS}"
    else
        EXTRA_OPTS="${CENV_SINGULARITY_OPTS}"
    fi

    # GPU support:
    CENV_GPU="${CENV_GPU:-$CENV_GPUS}" # Backward compatibility
    # GPU detection and support
    if [ -z "$CENV_GPU" ] ; then
        # auto-detect available GPU backends
        local _gpus=()
        if command -v nvidia-smi >/dev/null 2>&1 ; then
            _gpus+=("cuda")
        fi
        if command -v rocminfo >/dev/null 2>&1 ; then
            _gpus+=("rocm")
        fi
        # only add opencl if neither cuda nor rocm was found
        if [ ${#_gpus[@]} -eq 0 ] && [ -d "/etc/OpenCL/vendors" ] ; then
            _gpus+=("opencl")
        fi
        if [ ${#_gpus[@]} -gt 0 ] ; then
            export CENV_GPU="$(IFS=,; echo "${_gpus[*]}")"
            # echo "DEBUG: Detected GPU support: ${CENV_GPU}" >&2
        fi
    fi

    # enable selected GPU backends
    if [ -n "$CENV_GPU" ] ; then
        # split on commas, ignore empty tokens and trim whitespace
        local _gpu_backends _g
        IFS=',' read -ra _gpu_backends <<< "$CENV_GPU"
        unset IFS
        for _g in "${_gpu_backends[@]}"; do
        # trim leading/trailing whitespace
        _g="${_g#"${_g%%[![:space:]]*}"}"
        _g="${_g%"${_g##*[![:space:]]}"}"
        [ -z "$_g" ] && continue
        case "$_g" in
            none)
            ;;
            cuda)
            echo "INFO: Enabling ${CENV_RUNTIME} CUDA support" >&2
            EXTRA_OPTS="${EXTRA_OPTS} --nv"
            ;;
            rocm)
            echo "INFO: Enabling ${CENV_RUNTIME} ROCm support" >&2
            EXTRA_OPTS="${EXTRA_OPTS} --rocm"
            ;;
            opencl)
            echo "INFO: Mounting OpenCL vendors directory" >&2
            EXTRA_OPTS="${EXTRA_OPTS} -B /etc/OpenCL/vendors"
            ;;
            *)
            echo "WARNING: Unknown GPU backend '$_g', ignoring" >&2
            ;;
        esac
        done
    fi

    if [[ "$XDG_RUNTIME_DIR" == /run/* ]] && [[ -d "$XDG_RUNTIME_DIR" ]]; then
        EXTRA_OPTS="${EXTRA_OPTS} -B $XDG_RUNTIME_DIR"
    fi

    # echo "DEBUG: CENV_DIR=\"${CENV_DIR}\"" >&2
    # echo "DEBUG: CENV_USER_DIR=\"${CENV_USER_DIR}\"" >&2
    # echo "DEBUG: CENV_USER_MNT=\"${CENV_USER_MNT}\"" >&2
    # echo "DEBUG: FS_IMG=\"${FS_IMG}\"" >&2

    if (grep -q ' avx2 ' /proc/cpuinfo) ; then
        export OPENBLAS_CORETYPE="Haswell"
    elif (grep -q ' avx ' /proc/cpuinfo) ; then
        export OPENBLAS_CORETYPE="Sandybridge"
    fi

    export SWMOD_INST_BASE="${CENV_USER_MNT}/.local/sw"
    export SWMOD_MODPATH="${SWMOD_INST_BASE}"

    if [ "${CENV_RUNTIME}" = "apptainer" ]; then
        if [ "${CENV_HOME_DIR}" != "${HOME}" ]; then
            export APPTAINER_HOME="${CENV_HOME_DIR}:${CENV_HOME_MNT}"
        fi
        export APPTAINERENV_PS1="[\u@\[\e[1m\]${CENV_NAME}\[\e[m\] cenv] \w > "
        export APPTAINER_SHELL="${APPTAINER_SHELL:-${SHELL}}"
        # Add user bin dir to path:
        export APPTAINERENV_PREPEND_PATH="${CENV_USER_MNT}/.local/bin:${CENV_USER_MNT}/.julia/bin:${CENV_USER_MNT}/.cargo/bin"
    else
        if [ "${CENV_HOME_DIR}" != "${HOME}" ]; then
            export SINGULARITY_HOME="${CENV_HOME_DIR}:${CENV_HOME_MNT}"
        fi
        export SINGULARITYENV_PS1="[\u@\[\e[1m\]${CENV_NAME}\[\e[m\] cenv] \w > "
        export SINGULARITY_SHELL="${SINGULARITY_SHELL:-${SHELL}}"
        # Add user bin dir to path:
        export SINGULARITYENV_PREPEND_PATH="${CENV_USER_MNT}/.local/bin:${CENV_USER_MNT}/.julia/bin:${CENV_USER_MNT}/.cargo/bin"
    fi

    export debian_chroot="${CENV_NAME}"

    CENV_BIND_OPTS=()
    if [ "${CENV_USER_MNT}" != "${CENV_USER_DIR}" ] ; then
        CENV_BIND_OPTS=(
            -B "${CENV_USER_DIR}:${CENV_USER_MNT}"
            -B "${CENV_HOME_DIR}:${CENV_HOME_MNT}"
            -B "${CENV_USER_DIR}/.vscode-server:${CENV_VSCS_MNT}"
        )
    fi
}


# Container instances of cenv environments are named
# "${CENV_INSTANCE_PREFIX}CENV_NAME.SESSION_NAME". Session names must not
# contain a ".", so the environment name and the session name can always be
# recovered from the instance name:
CENV_INSTANCE_PREFIX="cenv-"


# Parses an instance specification "CENV_NAME/SESSION_NAME" (given as "$1",
# "$2" is the cenv option it was passed to). Sets CENV_INSTANCE_SPEC,
# CENV_INSTANCE_CENV_NAME and CENV_INSTANCE_NAME:
parse_cenv_instance_spec() {
    local spec="$1"
    local option="$2"

    if [ -z "${spec}" ] ; then
        echo "ERROR: Missing instance specification, use \``basename $0` ${option} CENV_NAME/SESSION_NAME\`." >&2
        exit 1
    fi

    if [ "${spec%/*}" = "${spec}" ] ; then
        echo "ERROR: Invalid instance specification \"${spec}\", must be of the form \"CENV_NAME/SESSION_NAME\"." >&2
        exit 1
    fi

    local cenv_name="${spec%/*}"
    local session_name="${spec##*/}"

    if ! [[ "${cenv_name}" =~ ^[A-Za-z0-9_][A-Za-z0-9._-]*$ ]] ; then
        echo "ERROR: Invalid environment name \"${cenv_name}\" in instance specification \"${spec}\"." >&2
        exit 1
    fi

    if ! [[ "${session_name}" =~ ^[A-Za-z0-9_][A-Za-z0-9_-]*$ ]] ; then
        echo "ERROR: Invalid session name \"${session_name}\", may only contain letters, digits, \"_\" and \"-\"." >&2
        exit 1
    fi

    CENV_INSTANCE_SPEC="${spec}"
    CENV_INSTANCE_CENV_NAME="${cenv_name}"
    CENV_INSTANCE_NAME="${CENV_INSTANCE_PREFIX}${cenv_name}.${session_name}"
}


# Aborts unless the selected container runtime engine supports instances:
cenv_require_instance_runtime() {
    if [ "${CENV_RUNTIME}" != "apptainer" ] && [ "${CENV_RUNTIME}" != "singularity" ] ; then
        echo "ERROR: Container instances require Apptainer or Singularity, but the container runtime engine is \"${CENV_RUNTIME}\"." >&2
        exit 1
    fi
}


# Prints the names of all running cenv container instances:
cenv_running_instances() {
    "${CENV_RUNTIME}" instance list 2>/dev/null | awk 'NR > 1 { print $1 }'
}


# Returns zero if the container instance "$1" is running:
cenv_instance_is_running() {
    cenv_running_instances | grep -q -x -F "$1"
}


# Runs "${@:2}" while holding an exclusive lock on the file "$1" (using file
# descriptor 9), if file locking is available:
cenv_with_lock() {
    local lockfile="$1"
    shift 1

    if ! command -v flock >/dev/null 2>&1 || ! (: >>"${lockfile}") 2>/dev/null ; then
        "$@"
        return
    fi

    ( flock -w 60 9 || true ; "$@" ) 9>>"${lockfile}"
}


# Starts the container instance ${CENV_INSTANCE_NAME} if it is not running yet:
cenv_instance_start() {
    if cenv_instance_is_running "${CENV_INSTANCE_NAME}" ; then
        return 0
    fi

    echo "INFO: Starting container instance \"${CENV_INSTANCE_SPEC}\"" >&2
    # The instance keeps running in the background and would inherit the lock
    # file descriptor (see cenv_with_lock) and so hold the lock forever, so
    # close that file descriptor for it:
    "${CENV_RUNTIME}" instance start ${EXTRA_OPTS} "${CENV_BIND_OPTS[@]}" \
        "${FS_IMG}" "${CENV_INSTANCE_NAME}" 9>&-
}


# Starts the container instance "CENV_NAME/SESSION_NAME" (given as "$1") if it
# is not running yet, then runs a shell or the program given by the remaining
# arguments in it:
cenv_instance() {
    parse_cenv_instance_spec "$1" "--instance"
    shift 1

    cenv_setup "${CENV_INSTANCE_CENV_NAME}"
    cenv_require_instance_runtime
    cenv_setup_apptainer

    # Concurrent attempts to start the same instance make the container
    # runtime clean up the instance that won the race, so serialize them:
    local lockfile
    if [ -d "${XDG_RUNTIME_DIR}" ] ; then
        lockfile="${XDG_RUNTIME_DIR}/${CENV_INSTANCE_NAME}.lock"
    else
        lockfile="${CENV_USER_DIR}/.${CENV_INSTANCE_NAME}.lock"
    fi

    if ! cenv_with_lock "${lockfile}" cenv_instance_start ; then
        # Without file locking, starting the instance may still have lost a
        # race against a concurrent "--instance" for the same instance:
        cenv_instance_is_running "${CENV_INSTANCE_NAME}" || exit 1
    fi

    # The home directory is fixed when the instance starts, APPTAINER_HOME
    # and SINGULARITY_HOME would only cause a spurious warning when
    # connecting to it:
    unset APPTAINER_HOME SINGULARITY_HOME

    local CMD
    if [ "$1" = "shell" ] ; then
        CMD="shell"
        shift 1
    elif [ -z "$1" ]; then
        CMD="shell"
    else
        CMD="exec"
    fi

    exec "${CENV_RUNTIME}" "${CMD}" "instance://${CENV_INSTANCE_NAME}" "$@"
}


# Stops the container instance "CENV_NAME/SESSION_NAME" (given as "$1"):
cenv_instance_stop() {
    parse_cenv_instance_spec "$1" "--stop"

    set_cenv_runtime
    cenv_require_instance_runtime

    if ! cenv_instance_is_running "${CENV_INSTANCE_NAME}" ; then
        echo "INFO: Container instance \"${CENV_INSTANCE_SPEC}\" is not running." >&2
        return 0
    fi

    "${CENV_RUNTIME}" instance stop "${CENV_INSTANCE_NAME}"
}


# Lists the running container instances as "CENV_NAME/SESSION_NAME",
# optionally only those of the environment given as "$1":
cenv_instances_list() {
    local cenv_filter="$1"

    set_cenv_runtime
    # Not an error, there simply can't be any instances without a container
    # runtime engine that supports them:
    if [ "${CENV_RUNTIME}" != "apptainer" ] && [ "${CENV_RUNTIME}" != "singularity" ] ; then
        return 0
    fi

    # Environment names may contain a ".", session names may not, so the
    # greedy match splits instance names at the right place:
    local instance_re="^${CENV_INSTANCE_PREFIX}(.+)\.([^.]+)$"

    local instance_name cenv_name session_name
    while read -r instance_name ; do
        # Skip container instances that weren't created by cenv:
        [[ "${instance_name}" =~ ${instance_re} ]] || continue
        cenv_name="${BASH_REMATCH[1]}"
        session_name="${BASH_REMATCH[2]}"

        if [ -z "${cenv_filter}" ] || [ "${cenv_filter}" = "${cenv_name}" ] ; then
            echo "${cenv_name}/${session_name}"
        fi
    done < <(cenv_running_instances)
}


PROG="$0"
CENV_NAME_ARG="$1"

# echo "CENV_BASE_DIR=\"${CENV_BASE_DIR}\"" >&2
# echo "CENV_NAME_ARG=\"${CENV_NAME_ARG}\"" >&2

if [ -z "${CENV_NAME_ARG}" ]; then
    invalid_argument_error "${CENV_NAME_ARG}" "$@"
fi

shift 1
CMD="$1"

if [ "${CENV_NAME_ARG}" = "${CENV_NAME}" ] ; then
    if [ "${CMD}" = "shell" -o -z "${CMD}" ]; then
        echo "Already in cenv ${CENV_NAME}, entering new shell ${SHELL} ..." >&2
        "${SHELL}"
    else
        echo "Note: Already in cenv ${CENV_NAME}." >&2
        exec "$@"
    fi
elif [ "${CENV_NAME_ARG}" = "--help" ] ; then
    cenv_help
elif [ "${CENV_NAME_ARG}" = "--list" ] ; then
    cenv_list "$@"
elif [ "${CENV_NAME_ARG}" = "--create" ] ; then
    cenv_create "$@"
elif [ "${CENV_NAME_ARG}" = "--instance" ] ; then
    cenv_instance "$@"
elif [ "${CENV_NAME_ARG}" = "--instances" ] ; then
    cenv_instances_list "$@"
elif [ "${CENV_NAME_ARG}" = "--stop" ] ; then
    cenv_instance_stop "$@"
else
    cenv_setup "${CENV_NAME_ARG}"

    if [ "${CMD}" = "shell" ]; then
        shift 1
    elif [ -z "${CMD}" ]; then
        CMD="shell"
    else
        CMD="exec"
    fi

    if [ "${CENV_RUNTIME}" = "apptainer" ] ||
       [ "${CENV_RUNTIME}" = "singularity" ]; then

        cenv_setup_apptainer

        # echo "DEBUG: CMD=\"${CMD} $@" >&2

        exec "${CENV_RUNTIME}" "${CMD}" ${EXTRA_OPTS} "${CENV_BIND_OPTS[@]}" \
            "${FS_IMG}" "$@"
    elif [ "${CENV_RUNTIME}" = "shifter" ] ; then
        EXTRA_OPTS="${CENV_SHIFTER_OPTS}"

        export XDG_RUNTIME_DIR="${TMPDIR:-/tmp}/`whoami`/run"
        mkdir -p "${XDG_RUNTIME_DIR}"

        # Docker image references resolve per-architecture via multi-arch
        # manifests, so an architecture-specific reference is supported but
        # normally not needed:
        if [ -f "${CENV_DIR}/rootfs-${CENV_ARCH}.shifter" ] ; then
            img_ref_file="${CENV_DIR}/rootfs-${CENV_ARCH}.shifter"
        else
            img_ref_file="${CENV_DIR}/rootfs.shifter"
        fi
        if [ ! -f "${img_ref_file}" ] ; then
            echo "ERROR: Missing image reference \"${img_ref_file}\"" >&2; exit 1
        fi
        img_name=`cat "${img_ref_file}"`

        # CENV_USER_DIR="${CENV_DIR}/user"
        # Workaround, shifter volume mounting doesn't seem to like deep directories:
        parent_dir=$(dirname `dirname "${CENV_DIR}"`)
        subst_userdir=".cenv_userdir_${CENV_NAME}"
        if [ ! -e "${CENV_DIR}/user" ] ; then
            ln -s "../../${subst_userdir}" "${CENV_DIR}/user"
        fi
        CENV_USER_DIR="${CENV_USER_DIR:-${parent_dir}/${subst_userdir}}"
        mkdir -p "${CENV_USER_DIR}"
        mkdir -p "${CENV_USER_DIR}/.vscode-server"

        if [ "${CENV_HOME_DIR}" != "${HOME}" ]; then
            export HOME="${CENV_HOME_DIR}"
        fi

        export PS1="[\u@\[\e[1m\]${CENV_NAME}\[\e[m\] cenv] \w > "

        if [ "${CENV_USER_MNT}" != "${CENV_USER_DIR}" ] ; then
            exec shifter --image="${img_name}" \
                --volume="${CENV_USER_DIR}:${CENV_USER_MNT};${CENV_HOME_DIR}:${CENV_HOME_MNT}" \
                 ${EXTRA_OPTS} -- "$@"
        else
            exec shifter --image="${img_name}" \
                 ${EXTRA_OPTS} -- "$@"
        fi
    else
        echo "ERROR: cenv internal error." >&2; exit 1
    fi
fi
